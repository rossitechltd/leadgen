# Google Sheets (shared module: sheets.py)
GOOGLE_SHEET_NAME=Lead Manager
GOOGLE_SERVICE_ACCOUNT_FILE=autoleadverification-e76d53033380.json

# Sheet tab names
SHEET_DYNAMIC_LEAD=Dynamic Lead Sheet
SHEET_ALL_IMPORTED=allimported
SHEET_READY_TO_CONTACT=Ready to Contact

# Apify — Step 1 Group Members Scraper
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=curious_coder/facebook-group-member-scraper
APIFY_PROXY_COUNTRY=GB
# Leave empty for datacenter proxy. Set RESIDENTIAL only if your plan includes it.
APIFY_PROXY_GROUPS=
APIFY_MIN_DELAY=1
APIFY_MAX_DELAY=10
# Limit members per group (leave empty for all)
APIFY_MEMBER_COUNT=20

# Facebook cookies (Cookie-Editor export while logged into facebook.com)
FB_COOKIES_FILE=credentials/fb_cookies.json
# Group URLs to scrape (copy config/groups.example.json → config/groups.json)
FB_GROUPS_FILE=config/groups.json

# Pipeline scheduler (local time)
PIPELINE_RUN_TIME=09:00
PIPELINE_ENABLED=true

# Server
HOST=127.0.0.1
PORT=8000

# Step 3 — Scrape Queue (one lead at row 2 for laptop MMM)
SHEET_SCRAPE_QUEUE=scrapesheet
SCRAPE_STATE_FILE=data/scrape_queue/active.json
SCRAPE_MIN_LENGTH=50
SCRAPE_QUEUE_DELAY_SECS=3
SCRAPE_MAX_ATTEMPTS=2
SCRAPE_MAX_FAILURES=3
SCRAPE_STABLE_SECS=2
SCRAPE_MIN_START_SECS=3
SCRAPE_STALL_SECS=120
# Minimum ~2 min before stall-fail; use 180–300 if MMM is slow to clear/paste column B
PAGE_SCRAPE_POLL_SECS=20
SCRAPE_ACTIVE_POLL_SECS=6
SCRAPE_QUEUE_POLL_ENABLED=true

# Sheets API — Google limits ~60 read requests/min per user; cache aggressively
SHEETS_CACHE_TTL_SECS=300
SCRAPE_QUEUE_ROW_CACHE_SECS=12
SHEETS_QUOTA_COOLDOWN_SECS=90

# Step 4 — Profile Refinement (Dynamic Lead Sheet: Scrape → refined)
REFINE_BATCH_SIZE=25
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
QUALIFY_WEBSITE_TIMEOUT_SECS=15

# Telegram operator alerts (immediate + digest while attention queue non-empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_MS=60000
# Override link in Telegram messages (default http://HOST:PORT)
DASHBOARD_URL=

# Step 1 pause/resume when Facebook cookies expire mid-run
STEP1_CHECKPOINT_FILE=data/step1_checkpoint.json
OPERATOR_ATTENTION_FILE=data/operator_attention.json


UPDATE